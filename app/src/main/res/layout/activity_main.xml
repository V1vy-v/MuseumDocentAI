<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面（DeepSeek 风格）：白底极简顶栏 + 居中对齐的空态 + 圆角输入卡片 + 左侧历史抽屉 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_bg">

        <!-- 顶栏：左抽屉按钮，右新建对话（其余功能收进输入区/抽屉） -->
        <LinearLayout
            android:id="@+id/layout_title"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/ds_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <Button
                android:id="@+id/btn_drawer"
                style="@style/ToolbarIconButton"
                android:text="@string/icon_drawer"
                android:textColor="@color/ds_text"
                android:textSize="20sp"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/app_title"
                android:textColor="@color/ds_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 语音播报 / 资料库：按用户要求放到右上角 -->
            <Button
                android:id="@+id/btn_voice"
                style="@style/DsPillButton"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/pill_voice_on"
                android:text="@string/pill_voice_on"
                tools:ignore="SpeakableTextPresentCheck" />

            <Button
                android:id="@+id/btn_browse"
                style="@style/DsPillButton"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/pill_browse"
                android:text="@string/pill_browse"
                tools:ignore="SpeakableTextPresentCheck" />

            <Button
                android:id="@+id/btn_new_chat"
                style="@style/ToolbarIconButton"
                android:contentDescription="@string/icon_new_chat"
                android:text="@string/icon_new_chat"
                android:textColor="@color/ds_text"
                android:textSize="18sp"
                tools:ignore="SpeakableTextPresentCheck" />
        </LinearLayout>

        <!-- 对话列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            app:layout_constraintBottom_toTopOf="@id/layout_status"
            app:layout_constraintTop_toBottomOf="@id/layout_title" />

        <!-- 空态：logo + 问候语 + 建议问题（DeepSeek 同款居中布局） -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/layout_status"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_title">

            <TextView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_ds_logo"
                android:gravity="center"
                android:text="@string/empty_icon"
                android:textSize="34sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/empty_greeting"
                android:textColor="@color/ds_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:text="@string/empty_hint"
                android:textColor="@color/ds_gray"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_suggest_1"
                style="@style/DsPillButton"
                android:layout_marginBottom="8dp"
                android:text="@string/suggest_1" />

            <Button
                android:id="@+id/btn_suggest_2"
                style="@style/DsPillButton"
                android:layout_marginBottom="8dp"
                android:text="@string/suggest_2" />

            <Button
                android:id="@+id/btn_suggest_3"
                style="@style/DsPillButton"
                android:text="@string/suggest_3" />
        </LinearLayout>

        <!-- 状态提示行 -->
        <LinearLayout
            android:id="@+id/layout_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="2dp"
            android:paddingEnd="20dp"
            android:paddingBottom="2dp"
            app:layout_constraintBottom_toTopOf="@id/layout_input">

            <ProgressBar
                android:id="@+id/progress_thinking"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/text_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/status_thinking"
                android:textColor="@color/ds_gray"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- 输入卡片：上方输入框，下方功能胶囊 + 圆形按钮 -->
        <LinearLayout
            android:id="@+id/layout_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_ds_input"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            app:layout_constraintBottom_toTopOf="@id/text_footer">

            <EditText
                android:id="@+id/edit_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/hint_question_ds"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:minHeight="28dp"
                android:textColor="@color/ds_text"
                android:textColorHint="@color/ds_gray"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_mic"
                    style="@style/DsCircleButton"
                    android:text="@string/btn_record"
                    tools:ignore="SpeakableTextPresentCheck" />

                <Button
                    android:id="@+id/btn_send"
                    style="@style/DsCircleButton"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_send"
                    android:text="@string/btn_send"
                    android:textColor="@color/text_on_brand"
                    tools:ignore="SpeakableTextPresentCheck" />
            </LinearLayout>
        </LinearLayout>

        <!-- 底部免责提示（DeepSeek 同款） -->
        <TextView
            android:id="@+id/text_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="10dp"
            android:text="@string/ai_disclaimer"
            android:textColor="@color/ds_gray"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 抽屉打开时的半透明遮罩 -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_scrim"
        android:visibility="gone" />

    <!-- 左侧历史抽屉 -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_ds_drawer"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_title"
            android:textColor="@color/ds_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_history_search"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ds_input"
            android:hint="@string/history_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/ds_text"
            android:textColorHint="@color/ds_gray"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_history"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <Button
            android:id="@+id/btn_drawer_settings"
            style="@style/DsPillButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="@string/btn_settings" />
    </LinearLayout>

</FrameLayout>
