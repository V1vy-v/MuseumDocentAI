<?xml version="1.0" encoding="utf-8"?>
<!-- 对话列表里的单条消息（DeepSeek 风格）：
     用户 → 右侧浅蓝气泡；AI → 左侧整段文字，不加气泡也不放头像 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_bubble_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingTop="8dp"
    android:paddingEnd="2dp"
    android:paddingBottom="8dp">

    <!-- 气泡文字：用户靠右浅蓝气泡、AI 靠左无背景 -->
    <TextView
        android:id="@+id/text_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="6dp"
        android:maxWidth="320dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:textColor="@color/ds_text"
        android:textSize="15sp"
        tools:text="你好，我是博物馆讲解助手" />

    <!-- 资料来源（默认隐藏，AI 回答带来源时显示） -->
    <TextView
        android:id="@+id/text_sources"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_source"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="@color/ds_blue"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="来源：越王勾践剑、湖北省博物馆"
        tools:visibility="visible" />

</LinearLayout>
