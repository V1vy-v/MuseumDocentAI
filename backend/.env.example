# ===== DeepSeek：文本问答 + 语音识别 + 语音合成 =====
# 文本 → deepseek-flash；语音识别 → /v1/tools/asr；语音合成 → /v1/tools/tts
DEEPSEEK_API_KEY=你的 DeepSeek 密钥填在这里
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-flash
# 可选：指定 TTS 音色，留空用平台默认
# DEEPSEEK_TTS_VOICE=

# ===== 火山 Ark：向量（RAG 必需）=====
# 文档向量化 → doubao-embedding-vision（2048 维）
# 另外：没配 DEEPSEEK_API_KEY 时，文本问答会自动退回这里的 doubao-seed-2.1-lite
ARK_API_KEY=你的火山方舟密钥填在这里
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_TEXT_MODEL=doubao-seed-2.1-lite
ARK_EMBED_MODEL=doubao-embedding-vision

# ===== 向量化换供应商（可选）=====
# 不填这三项就回落到上面的 ARK_*，只配火山的人不用管这一段。
# 注意：ARK_* 同时是文本模型的备用通道，所以不要把 ARK_BASE_URL 改指向别家。
# 实测（616 份资料 / 5726 块）：
#   火山 doubao-embedding-vision 2048 维，批量上限 10，约 50 分钟，会 429
#   SiliconFlow BAAI/bge-m3     1024 维，批量 100，约 1 分钟，未遇限频
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_API_KEY=你的 SiliconFlow 密钥
# EMBED_MODEL=BAAI/bge-m3
# EMBED_BATCH=100
# EMBED_DELAY_SECONDS=0.05

# ===== 备选 TTS（一般不需要）=====
# 想换语音供应商时填这几项，任意 OpenAI 兼容的 /audio/speech 都能用
# TTS_API_URL=
# TTS_API_KEY=
# TTS_MODEL=
# TTS_VOICE=

